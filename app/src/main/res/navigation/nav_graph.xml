<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mediatekaFragment">

    <action
        android:id="@+id/action_global_to_playerFragment"
        app:destination="@id/playerFragment" />

    <action
        android:id="@+id/action_global_to_newPlaylistFragment"
        app:destination="@id/newPlaylistFragment" />

    <action
        android:id="@+id/action_global_to_playlistFragment"
        app:destination="@id/playlistFragment" />

    <fragment
        android:id="@+id/searchComposeFragment"
        android:name="com.example.playlistmaker.search.ui.fragment.SearchComposeFragment"
        android:label="fragment_search_compose"
        tools:layout="@layout/fragment_search_compose">
        <action
            android:id="@+id/action_searchComposeFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
    </fragment>

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.example.playlistmaker.player.ui.fragment.PlayerFragment"
        android:label="fragment_player"
        tools:layout="@layout/fragment_player" />

    <fragment
        android:id="@+id/mediatekaFragment"
        android:name="com.example.playlistmaker.mediateka.ui.fragment.MediatekaFragment"
        android:label="fragment_mediateka"
        tools:layout="@layout/fragment_mediateka" />

    <fragment
        android:id="@+id/settingsComposeFragment"
        android:name="com.example.playlistmaker.settings.ui.fragment.SettingsComposeFragment"
        android:label="fragment_settings_compose"
        tools:layout="@layout/fragment_settings_compose" />

    <fragment
        android:id="@+id/newPlaylistFragment"
        android:name="com.example.playlistmaker.mediateka.playlists.ui.fragment.NewPlaylistFragment"
        android:label="fragment_new_playlist"
        tools:layout="@layout/fragment_new_playlist" />

    <fragment
        android:id="@+id/playlistFragment"
        android:name="com.example.playlistmaker.playlist.ui.fragment.PlaylistFragment"
        android:label="fragment_playlist"
        tools:layout="@layout/fragment_playlist" />
</navigation>